# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
# <src>                                         <mnt_point>  <type>  <mnt_flags and options>             <fs_mgr_flags>

/dev/block/platform/sprd-sdhci.3/by-name/SYSTEM   /system      ext4    ro,barrier=1                        wait
/dev/block/platform/sprd-sdhci.3/by-name/efs      /efs         ext4    noatime,nosuid,nodev,nomblk_io_submit,errors=remount-ro wait,check
/dev/block/platform/sprd-sdhci.3/by-name/PRODNV   /productinfo ext4    noatime,nosuid,nodev,nomblk_io_submit,errors=remount-ro wait,check
/dev/block/platform/sprd-sdhci.3/by-name/CACHE    /cache       ext4    noatime,nosuid,nodev,nomblk_io_submit,errors=remount-ro wait,check
/dev/block/platform/sprd-sdhci.3/by-name/userdata /data        ext4    nosuid,nodev,noatime,noauto_da_alloc,errors=remount-ro wait,check
/dev/block/platform/sprd-sdhci.3/by-name/userdata /data        f2fs    rw,nosuid,nodev,noatime,nodiratime,inline_xattr,inline_data wait,nonremovable

# VOLD:fstab.sc8830
/devices/sprd-sdhci.0/mmc_host/mmc1*            auto         vfat    defaults                            voldmanaged=sdcard1:auto,noemulatedsd
/devices/platform/dwc_otg.0/usb*                auto         auto    defaults                            voldmanaged=usbdisk:auto
